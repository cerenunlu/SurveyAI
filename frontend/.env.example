# Frontend service variables for Railway

# Browser-visible backend URL. Set this after Railway generates the backend public domain.
NEXT_PUBLIC_API_BASE_URL=https://surveyai-backend.up.railway.app

# Server-side fetch base. The public URL is fine; use a private Railway URL only
# if both services are in the same Railway project and private networking is configured.
INTERNAL_API_BASE_URL=https://surveyai-backend.up.railway.app
